# Environment files: commit examples only, never local credentials.
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# The genesis bundle is generated source consumed by the app and the public
# dashboard; it is committed on purpose so a fresh clone can build and verify.
!tamv-genesis/dist/
!tamv-genesis/dist/**

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
