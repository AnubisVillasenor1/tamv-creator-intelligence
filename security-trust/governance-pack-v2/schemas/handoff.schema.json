{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAMV advisory handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "schema_version", "created_at", "source_skill", "target_skill", "request_type", "scope", "inputs", "constraints", "supervision", "status"],
  "properties": {
    "handoff_id": {"type": "string", "pattern": "^HANDOFF-[A-Z0-9-]{3,80}$"},
    "schema_version": {"type": "string", "const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_skill": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_skill": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {
      "type": "object",
      "required": ["product", "asset"],
      "additionalProperties": false,
      "properties": {
        "product": {"type": "string", "minLength": 1, "maxLength": 256},
        "asset": {"type": "string", "minLength": 1, "maxLength": 256},
        "business_process": {"type": "string", "maxLength": 256},
        "jurisdictions": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true},
        "data_classes": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["evidence_id", "source", "observed_at", "digest", "classification"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source": {"type": "string", "minLength": 1, "maxLength": 512},
          "observed_at": {"type": "string", "format": "date-time"},
          "digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "classification": {"enum": ["public", "internal", "confidential", "restricted"]}
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["external_sharing", "data_minimization"],
      "additionalProperties": false,
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "horizon_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "external_sharing": {"type": "boolean", "const": false},
        "data_minimization": {"type": "boolean", "const": true}
      }
    },
    "supervision": {"enum": ["informational", "review", "expert", "blocked"]},
    "approver_roles": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "status": {"enum": ["pending_target_acceptance", "accepted", "rejected", "completed", "blocked"]},
    "signature_ref": {"type": ["string", "null"], "maxLength": 512}
  }
}
