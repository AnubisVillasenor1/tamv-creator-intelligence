{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAMV advisory handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "schema_version", "created_at", "source_skill", "target_skill", "request_type", "scope", "inputs", "constraints", "supervision", "status"],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_skill": {"type": "string", "minLength": 1},
    "target_skill": {"type": "string", "minLength": 1},
    "request_type": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["product", "asset"],
      "additionalProperties": false,
      "properties": {
        "product": {"type": "string"},
        "asset": {"type": "string"},
        "business_process": {"type": "string"},
        "jurisdictions": {"type": "array", "items": {"type": "string"}},
        "data_classes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "source", "observed_at", "digest", "classification"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "classification": {"enum": ["public", "internal", "confidential", "restricted"]}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {"type": "string", "minLength": 3, "maxLength": 3},
        "horizon_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "external_sharing": {"type": "boolean", "const": false},
        "data_minimization": {"type": "boolean", "const": true}
      }
    },
    "supervision": {"enum": ["informational", "review", "expert", "blocked"]},
    "approver_roles": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["pending_target_acceptance", "accepted", "rejected", "completed", "blocked"]},
    "signature_ref": {"type": ["string", "null"]}
  }
}
