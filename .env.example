# Public client configuration. Copy this file to .env.local for local development.
# Local-only classification used by the in-memory quota fallback.
# Set TAMV_DEPLOYMENT_ENV=production in the production environment manager.
TAMV_DEPLOYMENT_ENV=local

SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key

# Public Ed25519 SPKI PEM for verifying signed TAMV releases.
# Use escaped newlines (\\n) if the deployment UI only accepts one line.
TAMV_ATTRIBUTION_PUBLIC_KEY=replace-with-official-tamv-ed25519-public-key
# Public-key fallback for edge runtimes that expose only VITE_* variables.
VITE_TAMV_ATTRIBUTION_PUBLIC_KEY=replace-with-official-tamv-ed25519-public-key

# Set true for release builds that must be signed. Runtime gating is always fail-closed.
TAMV_APPROVAL_WATERMARK_SECRET=replace-with-at-least-32-random-characters
TAMV_CERTIFICATION_REQUIRED=false

# Server-side only. Never expose private keys with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
TAMV_INTEGRITY_SECRET=
# Release-only private key: provide through a secret manager, never in a committed env file.

# Server-only bearer token for /api/tamv/hypercore/metrics (minimum 32 random characters).
# Leave blank to keep metrics disabled. Never expose it via a VITE_ variable.
TAMV_METRICS_TOKEN=

# Stripe secrets and plan price IDs; server-side only. Use test-mode values before production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Canonical HTTPS application origin used for Stripe success/cancel URLs.
TAMV_APP_URL=https://example.invalid
# Stripe subscription metadata contract is set server-side at checkout:
# tamv_user_id (Supabase auth UUID) and tamv_plan_key (stable plan slug).
# Admin role must be assigned by trusted server tooling in Supabase app_metadata.
