# Public client configuration. Copy this file to .env.local for local development.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key

# Public Ed25519 SPKI PEM for verifying signed TAMV releases.
# Use escaped newlines (\n) if the deployment UI only accepts one line.
TAMV_ATTRIBUTION_PUBLIC_KEY=replace-with-official-tamv-ed25519-public-key
# Public-key fallback for edge runtimes that expose only VITE_* variables.
VITE_TAMV_ATTRIBUTION_PUBLIC_KEY=replace-with-official-tamv-ed25519-public-key

# Set true for release builds that must be signed. Runtime gating is always fail-closed.
TAMV_CERTIFICATION_REQUIRED=false

# Server-side only. Never expose private keys with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
TAMV_INTEGRITY_SECRET=
# Release-only private key: provide through a secret manager, never in a committed env file.
